<?xml version="1.0" encoding="UTF-8"?>
<museScore version="4.40">
  <!-- Stilul „de mana" al paginilor generate (scripts/bach.py --stil-randare), 2026-10-04.
       Fontul Petaluma (inclus in MuseScore 4, licenta SIL OFL) deseneaza cheile, cifrele,
       alteratiile si capetele de nota ca scrise cu mana. Coditele si barele de optimi mai
       groase, ca trasul cu penita pe paginile de mana reale (`pagina3`, „Doamne").
       Restul ca in bach-stil.mss: si ultimul sistem intins pe toata latimea. -->
  <Style>
    <lastSystemFillLimit>0</lastSystemFillLimit>
    <musicalSymbolFont>Petaluma</musicalSymbolFont>
    <musicalTextFont>Petaluma Text</musicalTextFont>
    <stemWidth>0.18</stemWidth>
    <beamWidth>0.7</beamWidth>
  </Style>
</museScore>
